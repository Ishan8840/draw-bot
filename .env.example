# Set on the server only. Never place the real key in frontend code or Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_TIMEOUT_SECONDS=60
# ASTRA_SCENE_DB=data/scene.sqlite3
# ASTRA_CHAT_DB=data/conversations.sqlite3

# Local voice. Install requirements-voice.txt, then python -m scripts.setup_voice.
VOICE_ENABLED=true
VOICE_MODEL_DIR=data/voice
STT_MODEL=small.en
FAST_STT_MODEL=tiny.en
STT_DEVICE=auto
STT_THREADS=2
STT_LANGUAGE=en
TTS_ENABLED=true
TTS_ENGINE=piper
PIPER_VOICE=en_US-lessac-medium
VAD_ENABLED=true
VAD_SILENCE_MS=450
VAD_MIN_SPEECH_MS=96
VAD_THRESHOLD=0.5
VOICE_INTERRUPT_ENABLED=true
VOICE_INTERRUPT_PHRASES="stop,pause,stop drawing,wait,cancel"
VOICE_PREVIEW_MS=480
VOICE_MAX_UTTERANCE_SECONDS=15

# Executor: virtual or mujoco. Use scripts.run_mujoco for the simulation.
ASTRA_EXECUTOR=virtual
# MUJOCO_GL=egl  # Linux headless; use glfw for a desktop, osmesa for software GL.
# MuJoCo always uses camera images. This toggle applies only to virtual raster images.
# ASTRA_BOARD_IMAGES=true

# MuJoCo live camera checks (default true); applies to all universal drawing tools.
SIM_VERIFY_MARKS=true
# Optional simulation-only faults. No wear values are sent to Astra.
SIM_CHALK_LOSS_M=0
SIM_CHALK_WEAR_RATE=0.002
