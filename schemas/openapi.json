  "components": {
    "schemas": {
      "AgentConfiguration": {
        "properties": {
          "configured": {
            "type": "boolean",
            "title": "Configured"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "max_rounds": {
            "type": "integer",
            "title": "Max Rounds"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "configured",
          "model",
          "max_rounds"
        ],
        "title": "AgentConfiguration"
      },
      "ChatEvent": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "turn_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Turn Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "user",
              "assistant",
              "tool_call",
              "tool_result",
              "error",
              "interruption"
            ],
            "title": "Kind"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "tool_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Name"
          },
          "call_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Call Id"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          },
          "source": {
            "type": "string",
            "enum": [
              "text",
              "voice",
              "board"
            ],
            "title": "Source",
            "default": "text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "turn_id",
          "kind",
          "content",
          "created_at"
        ],
        "title": "ChatEvent"
      },
      "ChatMessage": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Text"
          },
          "request_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Request Id"
          },
          "source": {
            "type": "string",
            "enum": [
              "text",
              "voice",
              "board"
            ],
            "title": "Source",
            "default": "text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "request_id"
        ],
        "title": "ChatMessage"
      },
      "ChatSession": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "idle",
              "thinking",
              "interrupted",
              "error"
            ],
            "title": "Status"
          },
          "turn_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Turn Id"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/ChatEvent"
            },
            "type": "array",
            "title": "Events"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "session_id",
          "status",
          "turn_id",
          "events"
        ],
        "title": "ChatSession"
      },
      "Circle": {
        "properties": {
          "type": {
            "type": "string",
            "const": "circle",
            "title": "Type"
          },
          "center": {
            "$ref": "#/components/schemas/Point"
          },
          "radius": {
            "type": "number",
            "maximum": 0.5,
            "exclusiveMinimum": 0.0,
            "title": "Radius"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "center",
          "radius"
        ],
        "title": "Circle"
      },
      "ControlCommand": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ControlCommand"
      },
      "CubicBezier": {
        "properties": {
          "type": {
            "type": "string",
            "const": "cubic_bezier",
            "title": "Type"
          },
          "start": {
            "$ref": "#/components/schemas/Point"
          },
          "control1": {
            "$ref": "#/components/schemas/Point"
          },
          "control2": {
            "$ref": "#/components/schemas/Point"
          },
          "end": {
            "$ref": "#/components/schemas/Point"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "start",
          "control1",
          "control2",
          "end"
        ],
        "title": "CubicBezier"
      },
      "DrawCommand": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "object_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Object Id"
          },
          "paths": {
            "items": {
              "$ref": "#/components/schemas/StrokeSpec"
            },
            "type": "array",
            "maxItems": 256,
            "minItems": 1,
            "title": "Paths"
          },
          "expected_generation": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Generation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "object_id",
          "paths"
        ],
        "title": "DrawCommand"
      },
      "DrawingObject": {
        "properties": {
          "object_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Object Id"
          },
          "source": {
            "type": "string",
            "enum": [
              "engine",
              "user"
            ],
            "title": "Source"
          },
          "generation": {
            "type": "integer",
            "title": "Generation"
          },
          "strokes": {
            "items": {
              "$ref": "#/components/schemas/StrokeState"
            },
            "type": "array",
            "title": "Strokes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "object_id",
          "source",
          "generation",
          "strokes"
        ],
        "title": "DrawingObject"
      },
      "ExecutionStatus": {
        "properties": {
          "revision": {
            "type": "integer",
            "title": "Revision"
          },
          "generation": {
            "type": "integer",
            "title": "Generation"
          },
          "status": {
            "type": "string",
            "enum": [
              "idle",
              "drawing",
              "paused",
              "cancelled"
            ],
            "title": "Status"
          },
          "speed": {
            "type": "number",
            "title": "Speed"
          },
          "current_stroke_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Stroke Id"
          },
          "pending": {
            "type": "integer",
            "title": "Pending"
          },
          "completed": {
            "type": "integer",
            "title": "Completed"
          },
          "cancelled": {
            "type": "integer",
            "title": "Cancelled"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "revision",
          "generation",
          "status",
          "speed",
          "current_stroke_id",
          "pending",
          "completed",
          "cancelled"
        ],
        "title": "ExecutionStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Line": {
        "properties": {
          "type": {
            "type": "string",
            "const": "line",
            "title": "Type"
          },
          "start": {
            "$ref": "#/components/schemas/Point"
          },
          "end": {
            "$ref": "#/components/schemas/Point"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "start",
          "end"
        ],
        "title": "Line"
      },
      "ModifyCommand": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "object_id": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Object Id"
          },
          "paths": {
            "items": {
              "$ref": "#/components/schemas/StrokeSpec"
            },
            "type": "array",
            "maxItems": 256,
            "minItems": 1,
            "title": "Paths"
          },
          "expected_generation": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Generation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
