{
  "$defs": {
    "Circle": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "circle",
          "title": "Type",
          "type": "string"
        },
        "center": {
          "$ref": "#/$defs/Point"
        },
        "radius": {
          "exclusiveMinimum": 0,
          "maximum": 0.5,
          "title": "Radius",
          "type": "number"
        }
      },
      "required": [
        "type",
        "center",
        "radius"
      ],
      "title": "Circle",
      "type": "object"
    },
    "CubicBezier": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "cubic_bezier",
          "title": "Type",
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/Point"
        },
        "control1": {
          "$ref": "#/$defs/Point"
        },
        "control2": {
          "$ref": "#/$defs/Point"
        },
        "end": {
          "$ref": "#/$defs/Point"
        }
      },
      "required": [
        "type",
        "start",
        "control1",
        "control2",
        "end"
      ],
      "title": "CubicBezier",
      "type": "object"
    },
    "DrawingObject": {
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "source": {
          "enum": [
            "engine",
            "user"
          ],
          "title": "Source",
          "type": "string"
        },
        "generation": {
          "title": "Generation",
          "type": "integer"
        },
        "strokes": {
          "items": {
            "$ref": "#/$defs/StrokeState"
          },
          "title": "Strokes",
          "type": "array"
        }
      },
      "required": [
        "object_id",
        "source",
        "generation",
        "strokes"
      ],
      "title": "DrawingObject",
      "type": "object"
    },
    "Line": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "line",
          "title": "Type",
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/Point"
        },
        "end": {
          "$ref": "#/$defs/Point"
        }
      },
      "required": [
        "type",
        "start",
        "end"
      ],
      "title": "Line",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "maximum": 1,
          "minimum": 0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 1,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    },
    "Polyline": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "polyline",
          "title": "Type",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/Point"
          },
          "maxItems": 4096,
          "minItems": 2,
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "type",
        "points"
      ],
      "title": "Polyline",
      "type": "object"
    },
    "Rectangle": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "rectangle",
          "title": "Type",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Point"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Width",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "type",
        "origin",
        "width",
        "height"
      ],
      "title": "Rectangle",
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "revision": {
          "default": 0,
          "title": "Revision",
          "type": "integer"
        },
        "generation": {
          "default": 0,
          "title": "Generation",
          "type": "integer"
        },
        "status": {
          "default": "idle",
          "enum": [
            "idle",
            "drawing",
            "paused",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "speed": {
          "default": 0.25,
          "title": "Speed",
          "type": "number"
        },
        "board_aspect_ratio": {
          "const": 1.0,
          "default": 1.0,
          "title": "Board Aspect Ratio",
          "type": "number"
        },
        "objects": {
          "items": {
            "$ref": "#/$defs/DrawingObject"
          },
          "title": "Objects",
          "type": "array"
        },
        "current_stroke_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Stroke Id"
        },
        "pending_stroke_ids": {
          "items": {
            "type": "string"
          },
          "title": "Pending Stroke Ids",
          "type": "array"
        },
        "completed_stroke_ids": {
          "items": {
            "type": "string"
          },
          "title": "Completed Stroke Ids",
          "type": "array"
        },
        "cancelled_stroke_ids": {
          "items": {
            "type": "string"
          },
          "title": "Cancelled Stroke Ids",
          "type": "array"
        }
      },
      "title": "Scene",
      "type": "object"
    },
    "StrokeState": {
      "additionalProperties": false,
      "properties": {
        "stroke_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Stroke Id",
          "type": "string"
        },
        "geometry": {
          "discriminator": {
            "mapping": {
              "circle": "#/$defs/Circle",
              "cubic_bezier": "#/$defs/CubicBezier",
              "line": "#/$defs/Line",
              "polyline": "#/$defs/Polyline",
              "rectangle": "#/$defs/Rectangle"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Line"
            },
            {
              "$ref": "#/$defs/Polyline"
            },
            {
              "$ref": "#/$defs/CubicBezier"
            },
            {
              "$ref": "#/$defs/Circle"
            },
            {
              "$ref": "#/$defs/Rectangle"
            }
          ],
          "title": "Geometry"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "executing",
            "completed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "executed_points": {
          "items": {
            "$ref": "#/$defs/Point"
          },
          "title": "Executed Points",
          "type": "array"
        },
        "executed_length": {
          "default": 0,
          "title": "Executed Length",
          "type": "number"
        },
        "total_length": {
          "title": "Total Length",
          "type": "number"
        },
        "progress": {
          "default": 0,
          "title": "Progress",
          "type": "number"
        }
      },
      "required": [
        "stroke_id",
        "geometry",
        "total_length"
      ],
      "title": "StrokeState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "scene",
      "default": "scene",
      "title": "Type",
      "type": "string"
    },
    "scene": {
      "$ref": "#/$defs/Scene"
    }
  },
  "required": [
    "scene"
  ],
  "title": "SceneEvent",
  "type": "object"
}
