  {
    "type": "function",
    "name": "pause_drawing",
    "description": "Pause the current execution without erasing ink or pending paths.",
    "parameters": {
      "additionalProperties": false,
      "properties": {},
      "type": "object",
      "required": []
    },
    "strict": true
  },
  {
    "type": "function",
    "name": "resume_drawing",
    "description": "Explicitly resume the currently paused valid plan.",
    "parameters": {
      "additionalProperties": false,
      "properties": {},
      "type": "object",
      "required": []
    },
    "strict": true
  },
  {
    "type": "function",
    "name": "cancel_drawing",
    "description": "Invalidate all current/pending strokes and preserve executed ink.",
    "parameters": {
      "additionalProperties": false,
      "properties": {},
      "type": "object",
      "required": []
    },
    "strict": true
  },
  {
    "type": "function",
    "name": "clear_board",
    "description": "Erase the virtual board and invalidate pending work. Only call when the user explicitly requests clearing.",
    "parameters": {
      "additionalProperties": false,
      "properties": {},
      "type": "object",
      "required": []
    },
    "strict": true
  }
