            "points"
          ],
          "type": "object"
        },
        "Rectangle": {
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "rectangle"
              ]
            },
            "origin": {
              "$ref": "#/$defs/Point"
            },
            "width": {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            "height": {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            }
          },
          "required": [
            "type",
            "origin",
            "width",
            "height"
          ],
          "type": "object"
